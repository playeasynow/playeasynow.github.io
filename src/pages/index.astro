---
import Layout from '../layouts/Layout.astro';
---

<Layout title="ezequiel calderon" activePage="home">

  <!-- ════ Hero · white ════ -->
  <section id="hero">
    <div class="hero-inner">
      <h1 class="hero-name" id="hero-name">
        <span class="first anaglyph hero-anaglyph-boot">ezequiel</span><br />
        <span class="last">calderon</span>
      </h1>
      <div class="hero-meta fade-up" style="--delay: 0.6s">
        <p class="hero-role">
          Senior Delivery Lead &nbsp;·&nbsp;
          <a href="https://www.akqa.com/leap/" target="_blank" rel="noopener">AKQA Leap</a>
          &nbsp;·&nbsp; Austin, TX
        </p>
        <p class="hero-tagline">
          <strong>I lead teams that solve complex enterprise and public-sector problems with modern solutions rooted in research, design, and shippable code.</strong>
        </p>
        <p class="hero-tagline">
          Currently in Senior Delivery at AKQA Leap and a former PwC consultant, I've delivered digital products for the likes of Google, Microsoft, and Salesforce. When I'm not shipping software, I'm navigating the complexities of state and federal hemp and cannabis policy.
        </p>
        <p class="hero-tagline">
          I live in Austin, TX. Where I've grown up and the queso thrives.
        </p>
        <div class="hero-ctas">
          <a href="/about" class="cta-primary">about me</a>
          <a href="https://www.linkedin.com/in/ezequielcalderonjr" target="_blank" rel="noopener" class="cta-secondary">get in touch</a>
        </div>
      </div>
    </div>
  </section>


  <!-- ════ Experience · gray ════ -->
  <section id="experience">
    <div class="section-label-wrap"><span class="section-label">— Experience</span></div>
    <div class="section-inner">
      <div class="timeline">

        <div class="tl-item current fade-up" style="--delay: 0s">
          <div class="tl-header">
            <div>
              <span class="tl-company">AKQA Leap</span>
              <span class="tl-location">Austin, TX &amp; London, UK</span>
            </div>
            <span class="tl-dates">2022 — present</span>
          </div>
          <p class="tl-role">Senior Delivery Lead</p>
          <p class="tl-desc">I lead feature delivery and UX research for developer.android.com, supporting a global audience of over 8M monthly users.</p>
          <ul class="tl-bullets">
            <li>Won and scaled new projects within Alphabet across Android, Maps, and other Google teams.</li>
            <li>Drive product roadmap for cross-functional teams of designers and developers, aligning stakeholders across the US, EU, and Australia.</li>
          </ul>
        </div>

        <div class="tl-item fade-up" style="--delay: 0.15s">
          <div class="tl-header">
            <div>
              <span class="tl-company">Praxent</span>
              <span class="tl-location">Austin, TX</span>
            </div>
            <span class="tl-dates">2019 — 2022</span>
          </div>
          <p class="tl-role">Senior Delivery Lead</p>
          <p class="tl-desc">Serviced SMBs in the financial services sector to build white-label platforms and greenfield fintech products.</p>
          <ul class="tl-bullets">
            <li>Led 5–6 product releases per quarter, managing high-volume backlogs for 2–3 different client products at a time.</li>
            <li>Served as Product Manager and Scrum Master to align third-party partners on roadmaps from MVP through continuous delivery.</li>
          </ul>
        </div>

        <div class="tl-item fade-up" style="--delay: 0.3s">
          <div class="tl-header">
            <div>
              <span class="tl-company">PwC</span>
              <span class="tl-location">San Francisco, CA</span>
            </div>
            <span class="tl-dates">2014 — 2018</span>
          </div>
          <p class="tl-role">Senior Management Consultant</p>
          <p class="tl-desc">Led large-scale software implementations and design thinking programs for 500+ senior staff across the US, Europe, and Asia.</p>
          <ul class="tl-bullets">
            <li>Owned program delivery for Salesforce, Zuora, and Oracle CPQ for 60+ global stakeholders.</li>
            <li>Defined 300+ complex requirements across Product, Legal, and Sales to ensure successful enterprise launches.</li>
            <li>Standardized US contract management practices for a newly acquired global firm (PRTM) to ensure operational alignment across new territories.</li>
          </ul>
        </div>

      </div>
    </div>
  </section>


  <!-- ════ Projects · white ════ -->
  <section id="projects">
    <div class="section-label-wrap"><span class="section-label">— Featured Projects</span></div>
    <div class="section-inner">

      <!-- Desktop + Tablet: grid -->
      <div class="projects-grid">

        <div class="pc-outer fade-up" style="--delay: 0s">
          <div class="pc"><div class="pc-content">
            <p class="pc-cat">Nonprofit · Event Production</p>
            <h3 class="pc-title">Trevor Runway</h3>
            <p class="pc-desc">Signature fundraiser for The Trevor Project. Raised $300K+ in combined donations across two years, with 400+ attendees per event.</p>
            <div class="pc-footer">2016 – 2017 &nbsp;·&nbsp; San Francisco, CA</div>
          </div></div>
        </div>

        <div class="pc-outer fade-up" style="--delay: 0.1s">
          <div class="pc"><div class="pc-content">
            <p class="pc-cat">Legislative Tracking Platform</p>
            <h3 class="pc-title">CPTN</h3>
            <p class="pc-desc">A full-stack solution for navigating complexity in regulated industries. Leverages AI-driven services to enable sophisticated querying and real-time compliance monitoring.</p>
            <div class="pc-footer">2025 – Present &nbsp;·&nbsp; Austin, TX</div>
          </div></div>
        </div>

        <div class="pc-outer fade-up" style="--delay: 0.2s">
          <div class="pc"><div class="pc-content">
            <p class="pc-cat">Advocacy · Digital Product</p>
            <h3 class="pc-title">Vote Ultraviolet</h3>
            <p class="pc-desc">Grassroots "Get Out The Vote" initiative based in Milwaukee. Led end-to-end design, development, and fundraising strategy to mobilize local voter engagement.</p>
            <div class="pc-footer">2020 &nbsp;·&nbsp; Milwaukee, WI</div>
          </div></div>
        </div>

        <div class="pc-outer fade-up" style="--delay: 0.1s">
          <div class="pc"><div class="pc-content">
            <p class="pc-cat">Governance · Non-Profit</p>
            <h3 class="pc-title">Forklift Danceworks</h3>
            <p class="pc-desc">President of the Board and Chair of the Executive Committee. Oversee organizational strategy, budgeting, and executive leadership for a 15-member board and full-time staff.</p>
            <div class="pc-footer">2021 – Present &nbsp;·&nbsp; Austin, TX</div>
          </div></div>
        </div>

        <div class="pc-outer fade-up" style="--delay: 0.2s">
          <div class="pc"><div class="pc-content">
            <p class="pc-cat">Product · UX Research</p>
            <h3 class="pc-title">Android Developers</h3>
            <p class="pc-desc">Lead research, design, and developer capabilities for developer.android.com. Focused on scaling global application quality and technical documentation for millions of developers.</p>
            <div class="pc-footer">2022 – Present &nbsp;·&nbsp; Global</div>
          </div></div>
        </div>

      </div>

      <!-- Mobile: carousel -->
      <div class="projects-carousel-wrap">
        <div class="projects-carousel" id="carousel">

          <div class="pc-outer">
            <div class="pc"><div class="pc-content">
              <p class="pc-cat">Nonprofit · Event Production</p>
              <h3 class="pc-title">Trevor Runway</h3>
              <p class="pc-desc">Signature fundraiser for The Trevor Project. Raised $300K+ in combined donations across two years, with 400+ attendees per event.</p>
              <div class="pc-footer">2016 – 2017 &nbsp;·&nbsp; San Francisco, CA</div>
            </div></div>
          </div>

          <div class="pc-outer">
            <div class="pc"><div class="pc-content">
              <p class="pc-cat">Legislative Tracking Platform · In Progress</p>
              <h3 class="pc-title">CPTN</h3>
              <p class="pc-desc">A full-stack solution for navigating complexity in regulated industries. Leverages AI-driven services to enable sophisticated querying and real-time compliance monitoring.</p>
              <div class="pc-footer">2025 – Present &nbsp;·&nbsp; Austin, TX</div>
            </div></div>
          </div>

          <div class="pc-outer">
            <div class="pc"><div class="pc-content">
              <p class="pc-cat">Advocacy · Digital Product</p>
              <h3 class="pc-title">Vote Ultraviolet</h3>
              <p class="pc-desc">Grassroots "Get Out The Vote" initiative based in Milwaukee. Led end-to-end design, development, and fundraising strategy to mobilize local voter engagement.</p>
              <div class="pc-footer">2020 &nbsp;·&nbsp; Milwaukee, WI</div>
            </div></div>
          </div>

          <div class="pc-outer">
            <div class="pc"><div class="pc-content">
              <p class="pc-cat">Governance · Non-Profit</p>
              <h3 class="pc-title">Forklift Danceworks</h3>
              <p class="pc-desc">President of the Board and Chair of the Executive Committee. Oversee organizational strategy, budgeting, and executive leadership for a 15-member board and full-time staff.</p>
              <div class="pc-footer">2021 – Present &nbsp;·&nbsp; Austin, TX</div>
            </div></div>
          </div>

          <div class="pc-outer">
            <div class="pc"><div class="pc-content">
              <p class="pc-cat">Product · UX Research</p>
              <h3 class="pc-title">Android Developers</h3>
              <p class="pc-desc">Lead research, design, and developer capabilities for developer.android.com. Focused on scaling global application quality and technical documentation for millions of developers.</p>
              <div class="pc-footer">2022 – Present &nbsp;·&nbsp; Global</div>
            </div></div>
          </div>

        </div>
        <div class="carousel-dots" id="carousel-dots">
          <div class="carousel-dot active"></div>
          <div class="carousel-dot"></div>
          <div class="carousel-dot"></div>
          <div class="carousel-dot"></div>
          <div class="carousel-dot"></div>
        </div>
      </div>

    </div>
  </section>


  <!-- ════ Skills · gray ════ -->
  <section id="skills">
    <div class="section-label-wrap"><span class="section-label">— Skills</span></div>
    <div class="section-inner">
      <div class="skills-grid fade-up">
        <div>
          <p class="skills-col-title">Delivery &amp; Leadership</p>
          <div class="pills">
            <span class="pill">Project Management</span>
            <span class="pill">Agile / Scrum</span>
            <span class="pill">Client Management</span>
            <span class="pill">Product Delivery</span>
            <span class="pill">Team Leadership</span>
            <span class="pill">Design Thinking</span>
            <span class="pill">Stakeholder Alignment</span>
            <span class="pill">Curriculum Design</span>
          </div>
        </div>
        <div>
          <p class="skills-col-title">Technical</p>
          <div class="pills">
            <span class="pill">HTML / CSS</span>
            <span class="pill">JavaScript</span>
            <span class="pill">React.js</span>
            <span class="pill">Node.js</span>
            <span class="pill">MERN Stack</span>
            <span class="pill">Git / GitHub</span>
            <span class="pill">MySQL</span>
            <span class="pill">MongoDB</span>
            <span class="pill">Astro</span>
            <span class="pill">Tailwind CSS</span>
          </div>
        </div>
      </div>
    </div>
  </section>

</Layout>
