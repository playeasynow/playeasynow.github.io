---
import Layout from '../layouts/Layout.astro';
---

<Layout title="about · ezequiel calderon" activePage="about">

  <!-- ════ About · white ════ -->
  <section id="about-hero">
    <div class="section-inner">
      <span class="section-label">— About</span>

      <div class="about-grid">

        <!-- Portrait -->
        <div class="fade-up">
          <div class="portrait">
            <!--
              Image currently loaded from your GitHub repo.
              Once you've cloned the project locally, replace with:
              <img src="/assets/Ezequiel_2020_Portrait.png" alt="Ezequiel Calderon" />
              and copy the file to public/assets/
            -->
            <img
              src="https://raw.githubusercontent.com/playeasynow/playeasynow.github.io/master/assets/img-vid/Ezequiel_2020_Portrait.png"
              alt="Ezequiel Calderon"
            />
          </div>
        </div>

        <!-- Bio -->
        <div class="fade-up">
          <h2 class="bio-heading">Hi there!</h2>
          <div class="bio-body">
            <p>
              I'm Ezequiel, a strategist and product leader fascinated by complex
              real-world challenges, and great queso.
            </p>
            <p>
              My journey has taken me from music performance to management consulting
              at PwC, and now to
              <a href="https://www.akqa.com/leap/" class="bio-link" target="_blank" rel="noopener">AKQA Leap</a>,
              where I serve as a Senior Delivery Lead. This diverse foundation allows
              me to lead multidisciplinary teams in translating high-level business
              goals into top quality project delivery and ultimately, shippable code
              for global brands like HP, Microsoft, and Google.
            </p>
            <p>
              Software is ever-evolving, but I get most excited about the projects
              that bridge digital innovation and high-stakes policy. That passion led
              me to co-found
              <a href="https://ja.partners" class="bio-link" target="_blank" rel="noopener">Jefferson &amp; Associates</a>
              with long-time partners, where I navigate the evolving regulatory
              complexities of the hemp and cannabis industry in the US and worldwide.
              This legislative navigation requires the same precision as any Fortune
              500 product roadmap: transforming ambiguous hurdles into strategic,
              modern solutions.
            </p>
            <p>
              Beyond my core trade, I'm deeply committed to the Austin community. I
              actively engage in volunteer and board service — for organizations like
              <a href="https://www.thetrevorproject.org" class="bio-link" target="_blank" rel="noopener">The Trevor Project</a>
              in the past and
              <a href="https://www.forkliftdanceworks.org" class="bio-link" target="_blank" rel="noopener">Forklift Danceworks</a>
              these days — to help ensure that innovative, connective experiences are accessible
              to everyone. When I'm not strategizing for a product or a policy, I'm
              listening to podcasts, singing, playing the piano or violin, or riding
              my bike.
            </p>
          </div>
        </div>

      </div>
    </div>
  </section>


  <!-- ════ Contact · gray ════ -->
  <section id="contact">
    <div class="section-inner">
      <span class="section-label">— Contact</span>

      <div class="contact-grid">
        <p class="contact-desc">
          Don't hesitate to reach out. Happy to answer any and all inquiries.
        </p>

        <div class="contact-items fade-up">
          <div>
            <span class="contact-item-label">Email</span>
            <a href="mailto:ezequiel.calderon.jr@gmail.com" class="contact-item-link">ezequiel.calderon.jr@gmail.com</a>
          </div>
          <div>
            <span class="contact-item-label">Resume</span>
            <a href="/EzequielCalderon_Resume_2026.pdf" target="_blank" rel="noopener" class="contact-item-link">Download PDF copy</a>
          </div>
          <div>
            <span class="contact-item-label">Elsewhere</span>
            <div class="contact-social">
              <a href="https://linkedin.com/in/ezequielcalderonjr/" class="contact-item-link" target="_blank" rel="noopener">LinkedIn</a>
              <a href="https://github.com/playeasynow" class="contact-item-link" target="_blank" rel="noopener">GitHub</a>
              <a href="https://instagram.com/playeasynow/" class="contact-item-link" target="_blank" rel="noopener">Instagram</a>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

</Layout>
